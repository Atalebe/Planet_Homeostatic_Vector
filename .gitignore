# --- Data ---
# Ignore raw archive downloads (big, reproducible by download script)
data/raw/**

# Ignore derived outputs by default...
data/derived/**

# ...but keep lightweight summaries, scorecards, run metadata, and diagnostics
!data/derived/**/summary.json
!data/derived/**/run_meta.json
!data/derived/**/*scorecard*.csv
!data/derived/**/ps_selection_diagnostic_*.csv

# If you keep config snapshots in derived, allow them too (optional)
#!data/derived/**/config_*.yaml

